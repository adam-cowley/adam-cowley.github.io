---
import Base from "@layouts/Base.astro";
import PageTitle from "@ui/molecules/PageTitle.astro";
import Tag from "@ui/atoms/Tag.astro";
import { getPosts, groupBy } from "@lib/posts";

const tags = groupBy(await getPosts(), "tags");
---

<Base title="Tags">
  <div class="container">
    <PageTitle kicker="/tags" title="Tags" />
    <ul class="cloud">
      {tags.map((t) => <li><Tag href={`/tags/${t.slug}`}>#{t.label} · {t.posts.length}</Tag></li>)}
    </ul>
  </div>
</Base>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 28px 0 56px;
    border-top: 2px solid var(--tx);
  }
</style>
