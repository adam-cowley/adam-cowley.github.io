---
import Base from "@layouts/Base.astro";
import PageTitle from "@ui/molecules/PageTitle.astro";
import PostRow from "@ui/molecules/PostRow.astro";
import { getPosts, groupBy } from "@lib/posts";

export async function getStaticPaths() {
  const tags = groupBy(await getPosts(), "tags");
  return tags.map((t) => ({ params: { tag: t.slug }, props: { tag: t } }));
}

const { tag } = Astro.props;
---

<Base title={`#${tag.label}`}>
  <div class="container">
    <PageTitle kicker="/tags" title={`#${tag.label}`} size="title" />
    <div class="list">
      {tag.posts.map((p) => <PostRow post={p} variant="full" level="h2" />)}
    </div>
  </div>
</Base>

<style>
  .list {
    border-top: 2px solid var(--tx);
    margin-bottom: 56px;
  }
</style>
