---
import Base from "@layouts/Base.astro";
import PageTitle from "@ui/molecules/PageTitle.astro";
import CircleArt from "@ui/visuals/CircleArt.astro";
import Button from "@ui/atoms/Button.astro";
---

<Base title="Not found" noindex>
  <div class="container">
    <div class="wrap">
      <div>
        <PageTitle kicker="/404" title="Lost the thread">
          That page isn't in the graph. Try the writing index, or press ⌘K to search.
        </PageTitle>
        <Button href="/posts">All writing →</Button>
      </div>
      <div class="art"><CircleArt variant="lines" /></div>
    </div>
  </div>
</Base>

<style>
  .wrap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    align-items: center;
    padding-bottom: 64px;
  }
  .art {
    max-width: 380px;
    justify-self: center;
    width: 100%;
  }
</style>
