---
import Base from "@layouts/Base.astro";
import PageTitle from "@ui/molecules/PageTitle.astro";
import Button from "@ui/atoms/Button.astro";
---

<Base title="Not found" noindex>
  <div class="container">
    <div class="wrap">
      <div>
        <PageTitle kicker="/404" title="Lost the thread">
          That page isn't in the graph. Try the writing index, or press ⌘K to search.
        </PageTitle>
        <Button href="/posts">All writing →</Button>
      </div>
    </div>
  </div>
</Base>

<style>
  .wrap {
    padding-bottom: 64px;
  }
</style>
