---
import Base from "@layouts/Base.astro";
import PageTitle from "@ui/molecules/PageTitle.astro";
import PostRow from "@ui/molecules/PostRow.astro";
import { getPosts, groupBy } from "@lib/posts";

export async function getStaticPaths() {
  const topics = groupBy(await getPosts(), "categories");
  return topics.map((t) => ({ params: { category: t.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;
---

<Base title={topic.label}>
  <div class="container">
    <PageTitle kicker="/topics" title={topic.label} />
    <div class="list">
      {topic.posts.map((p) => <PostRow post={p} variant="full" level="h2" />)}
    </div>
  </div>
</Base>

<style>
  .list {
    border-top: 2px solid var(--tx);
    margin-bottom: 56px;
  }
</style>
