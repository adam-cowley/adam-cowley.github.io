---
import Base from "@layouts/Base.astro";
import PageTitle from "@ui/molecules/PageTitle.astro";
import PillarCard from "@ui/molecules/PillarCard.astro";
import { getPosts, groupBy } from "@lib/posts";

const topics = groupBy(await getPosts(), "categories");
---

<Base title="Topics">
  <div class="container">
    <PageTitle kicker="/topics" title="Topics" />
    <div class="grid">
      {
        topics.map((t, i) => (
          <PillarCard
            index={i + 1}
            title={t.label}
            description={`${t.posts.length} ${t.posts.length === 1 ? "post" : "posts"}, latest: ${t.posts[0].title}`}
            href={`/categories/${t.slug}`}
          />
        ))
      }
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    border-top: 2px solid var(--tx);
    margin-bottom: 56px;
  }
</style>
