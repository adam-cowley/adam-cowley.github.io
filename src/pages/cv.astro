---
import { FaEnvelope, FaMapMarkerAlt, FaLinkedin } from "react-icons/fa";
import config from "@config/config.json";

const title = "Curriculum Vitae | Adam Cowley";
const url = `${config.site.base_url}/cv`;

const timeline = [
  { y: "2026", t: `<a href="https://medium.com/neo4j/why-im-replacing-my-rag-based-chatbot-with-agents-1718ec7e384c">Rebuilt GraphAcademy</a> with frontier models — 90%+ AI-generated, placing AI front and centre`, d: "Complete rebuild in three months; replaced the RAG chatbot with an agent that acts on the learner's behalf." },
  { y: "2025", t: "Promoted to Manager, Developer Education", d: "Took formal ownership of Generative AI strategy for developer enablement, growing the team from two to six." },
  { y: "2023", t: "Data analysis for Swindon Town FC — contributed to several first-team signings", d: "Applied AI and data automation to opposition scouting and player profiling for recruitment." },
  { y: "2022", t: `<a href="https://medium.com/neo4j/introducing-the-new-graphacademy-fd9b1dbce753">Relaunched GraphAcademy</a>, growing enrolments from 2k to over 150k a year`, d: "Rebuilt the platform as a hands-on, interactive product from the ground up." },
  { y: "2020", t: "Transitioned to Developer Relations at Neo4j", d: "Built open-source tools and libraries to improve developer experience and adoption." },
  { y: "2017", t: "Joined Neo4j as a Professional Services Consultant", d: "Consultancy, training and technical account management for key accounts across EMEA." },
  { y: "2014–2016", t: "Founder of a consultancy and freelance developer", d: `Working with global brands including HP, Google & GWR, and published in <a href="https://en.wikipedia.org/wiki/Net_(magazine)">net Magazine</a> #300.` },
];

const skills = [
  ["Generative AI", "Agents, skills, prompt, context & loop engineering, RAG & GraphRAG"],
  ["Leadership", "Team management, strategy, hiring"],
  ["Engineering", "TypeScript, Python, React, Java, Neo4j, SQL, TDD, DDD"],
];

const talks = [
  ["UI in the Age of AI", "MCP Dev Summit NA & DEVWorld · 2026"],
  ["Hands-on GraphRAG", "AI Engineer, Paris · 2025"],
  ["Building AI Tool Integrations with MCP", "WeAreDevelopers, Berlin · 2025"],
  ["Generative AI for Front-end Developers - Talk and Workshop", "CityJS Athens & London · 2023–2024"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={config.site.favicon} />
    <title>{title}</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href={url} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gloock&family=Geist:wght@300..700&display=swap" rel="stylesheet" />
  </head>
  <body>
  <main>
    <div class="sheet" id="cv">
      <section class="page">
        <header class="head">
          <img src="/images/picture-blurred.png" alt="Adam Cowley" />
          <div>
            <h1>Adam Cowley</h1>
            <p class="tag">I design and build systems — in code and beyond — using AI to make them faster to build and better over time.</p>
            <div class="contact">
              <span><FaMapMarkerAlt /> Wiltshire, UK</span>
              <span><FaEnvelope /> <a href="mailto:hello@adamcowley.co.uk">hello@adamcowley.co.uk</a></span>
              <span><FaLinkedin /> <a href="https://linkedin.com/in/adamcowley">/in/adamcowley</a></span>
            </div>
          </div>
        </header>

        <ul class="summary">
          <li>Designs and builds systems — and the teams that ship them — leading Generative AI education at Neo4j.</li>
          <li>Rebuilt GraphAcademy as an agent-led product — scaling the team from two to six and enrolments from <b>2k to 150k+ a year</b> at <b>44% completion</b>.</li>
          <li>International conference speaker on Generative AI, MCP, GraphRAG and agents.</li>
        </ul>

        <div class="cols">
          <ol class="timeline">
            {timeline.map((e) => (
              <li>
                <div class="t"><span class="y">{e.y}</span> – <Fragment set:html={e.t} /></div>
                <div class="d" set:html={e.d} />
              </li>
            ))}
          </ol>
          <aside>
            <h2>Skills</h2>
            <ul class="mini">
              {skills.map(([a, b]) => <li><b>{a}</b><span>{b}</span></li>)}
            </ul>
            <h2>Speaking</h2>
            <p class="note">A selection — many more delivered online and in person.</p>
            <ul class="mini">
              {talks.map(([a, b]) => <li><b>{a}</b><span>{b}</span></li>)}
            </ul>
          </aside>
        </div>
      </section>

      <section class="page">
        <h2 class="big">Employment</h2>

        <div class="job">
          <div class="main">
            <h3>Developer Relations &amp; Professional Services — Neo4j</h3>
            <div class="role">
              <h4>Manager, Developer Education <em>April 2025 – Present</em></h4>
              <ul>
                <li>Leads the Gen AI-driven transformation of developer enablement at Neo4j — using Generative AI (Claude Code, frontier models) to rebuild GraphAcademy into an ecosystem the <b>whole team can contribute to</b>, with an <a href="https://medium.com/neo4j/why-im-replacing-my-rag-based-chatbot-with-agents-1718ec7e384c">agent-based learning experience</a> front and centre.</li>
                <li>Grew and manage a team of <b>six</b>, up from two, and scaled GraphAcademy from <b>2k to over 150k enrolments a year</b> at a <b>44% completion rate</b>.</li>
                <li>Owns developer-education strategy, with the AI platform work now enabling training across the <b>entire company</b>.</li>
              </ul>
            </div>
            <div class="role">
              <h4>Developer Advocate – Developer Education Lead <em>March 2021 – April 2025</em></h4>
              <ul>
                <li>Pioneered Generative AI driven learning, including a <a href="https://medium.com/neo4j/building-an-educational-chatbot-for-graphacademy-with-neo4j-f707c4ce311b">learning assistant chatbot</a> and courses on Generative AI with Neo4j.</li>
                <li>Levelled from Senior to Staff Developer Advocate; <a href="https://medium.com/neo4j/building-an-educational-platform-on-neo4j-d7dc195b9466">transformed GraphAcademy</a> from static pages into an interactive learning experience, growing enrolments from <b>2k to over 150k a year</b>.</li>
              </ul>
            </div>
            <div class="role">
              <h4>Developer Experience Engineer <em>March 2020 – March 2021</em></h4>
              <ul>
                <li>Improved developer experience across the platform, turning user feedback into product improvements.</li>
                <li>Led documentation migration to a modern build system and released open-source libraries to accelerate onboarding.</li>
              </ul>
            </div>
            <div class="role">
              <h4>Senior Professional Services Consultant <em>July 2017 – March 2020</em></h4>
              <ul>
                <li>Delivered high-impact graph-based solutions across EMEA.</li>
                <li>Led innovation labs, bootcamps and training programs for enterprise clients.</li>
              </ul>
            </div>
          </div>
          <blockquote>
            “Adam’s analytical acumen, combined with his agility and precision, significantly advanced our clients’ digital initiatives, leading to measurable business impacts. He expertly translated complex technical concepts into clear, actionable strategies. Adam also excelled in leading the technical components of our workshops, adeptly managing diverse groups—from engineers to C-level executives—ensuring all participants remained engaged and aligned.”
            <footer><b>Stefan Wendin</b>Head of Innovation Lab, Neo4j</footer>
          </blockquote>
        </div>

        <div class="job">
          <div class="main">
            <h3>Founder &amp; Lead Developer — Commit <em>April 2015 – April 2019</em></h3>
            <ul>
              <li>Founded technology consultancy delivering solutions for startups and global companies.</li>
              <li>Business critical data collection and reporting system for GWR, used by 5,000+ employees daily.</li>
              <li><a href="https://sensori.al/projects/google-nyc-popup/">Interactive photosphere</a> for a Google popup store in NYC.</li>
            </ul>
          </div>
          <blockquote>
            “In three months, Adam has delivered a system that is critical to our business what others have failed to deliver in more than 18 months. He quickly understood our business needs and delivered a reliable solution that met every requirement.”
            <footer><b>George Hart</b>Head of PMO, Great Western Railway (GWR)</footer>
          </blockquote>
        </div>

        <div class="job">
          <div class="main">
            <h3>Lead Developer — Eskimo Media and Technology <em>June 2013 – June 2015</em></h3>
            <ul>
              <li>HP Connected Music — streaming platform for HP and Universal Music; 20k+ MAUs.</li>
            </ul>
          </div>
        </div>

        <div class="job">
          <div class="main">
            <h3>Systems Developer — New College Swindon <em>June 2006 – May 2010</em></h3>
            <ul>
              <li>Mapped and migrated over 50k student records to new system.</li>
              <li>Replaced week-long manual curriculum allocation process with 10-second automated system.</li>
            </ul>
          </div>
          <blockquote>
            “Adam is a very dedicated person, with great knowledge of systems development. A great team player, and with a very positive attitude. Easy going, and approachable, always willing to help with requests.”
            <footer><b>Ben Sonoiki</b>Learner Data Manager, New College Swindon</footer>
          </blockquote>
        </div>

        <div class="edu">
          <div>
            <h3>Education</h3>
            <ul class="plain">
              <li><b>HND Computing</b><br />New College Swindon, 2005–2007</li>
              <li><b>BTEC National Diploma for IT Practitioners (Software)</b><br />New College Swindon, 2003–2005</li>
            </ul>
          </div>
          <div>
            <h3>Certifications</h3>
            <ul>
              <li>Neo4j Certified Professional</li>
              <li>PFSA Level 2 Opposition Analysis in Football</li>
              <li>PFSA Level 2 Technical Scouting in Football</li>
              <li>PFSA Level 1 Talent Identification</li>
            </ul>
          </div>
        </div>
      </section>
    </div>
  </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f2e7;
    --paper: #fffdf7;
    --tx: #1b2b23;
    --mu: #4b5a50;
    --ac: #7f5f10;
    --ln: rgba(154, 116, 22, 0.5);
    --ln2: rgba(154, 116, 22, 0.25);
    --sf: #ece5d0;
    --gr: #1f4d3a;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--tx);
    font: 400 14px/1.45 "Geist", system-ui, sans-serif;
  }
  #cv a { color: var(--ac); text-decoration: underline; text-underline-offset: 2px; }
  #cv h1, #cv h2.big { font-family: "Gloock", Georgia, serif; font-weight: 400; margin: 0; }
  #cv h1, #cv h2, #cv h3, #cv h4 { margin: 0; color: var(--gr); font-family: "Gloock", Georgia, serif; font-weight: 400; }
  #cv ul, #cv ol { margin: 0; list-style: disc; }

  .sheet { max-width: 210mm; margin: 24px auto; display: grid; gap: 24px; }
  .page { background: var(--paper); padding: 14mm 15mm; box-shadow: 0 1px 12px rgba(27, 43, 35, 0.12); }

  .head { display: flex; gap: 20px; align-items: center; padding-bottom: 12px; border-bottom: 1px solid var(--ln); }
  .head img { width: 96px; height: 96px; object-fit: cover; border-radius: 10px; flex: none; }
  h1 { font-size: 34px; line-height: 1.1; }
  .tag { margin: 4px 0 8px; font-style: italic; color: var(--mu); font-size: 14.5px; }
  .contact { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 12.5px; }
  .contact span { display: inline-flex; align-items: center; gap: 6px; }
  .contact svg { color: var(--ac); }

  .summary { padding-left: 18px !important; margin: 14px 0 16px !important; }
  .summary li + li { margin-top: 2px; }

  .cols { display: grid; grid-template-columns: 1fr 64mm; gap: 8mm; padding-top: 18px; border-top: 1px solid var(--ln2); }
  .timeline { list-style: none; padding: 0 0 0 18px; border-left: 2px dashed rgba(31, 77, 58, 0.45); }
  .timeline li { position: relative; padding-bottom: 14px; }
  .timeline li:last-child { padding-bottom: 0; }
  .timeline li::before { content: ""; position: absolute; left: -25px; top: 3px; width: 12px; height: 12px; box-sizing: border-box; border-radius: 50%; background: var(--paper); border: 2px solid var(--gr); }
  .timeline .t { font-weight: 600; margin-bottom: 1px; }
  .timeline .y { color: var(--gr); }
  .timeline .d { color: var(--mu); font-size: 12.5px; margin-top: 2px; }

  aside h2 { font-size: 18px; margin-bottom: 8px; }
  aside h2:not(:first-child) { margin-top: 20px; }
  #cv .mini, #cv .timeline, #cv .edu ul.plain { list-style: none; }
  .mini { padding: 0; }
  .mini li { margin-bottom: 8px; }
  .mini b { display: block; font-weight: 600; font-size: 13px; }
  .mini span { color: var(--mu); font-size: 12px; }
  .note { margin: 0 0 8px; color: var(--mu); font-size: 12px; font-style: italic; }

  h2.big { font-size: 26px; margin-bottom: 14px; }
  .job { display: grid; grid-template-columns: 1fr 58mm; gap: 8mm; padding: 14px 0; border-top: 1px solid var(--ln2); break-inside: avoid; }
  .job:not(:has(blockquote)) { grid-template-columns: 1fr; }
  h3 { font-size: 17px; line-height: 1.25; }
  h3 em, h4 em { font-family: "Geist", system-ui, sans-serif; font-style: normal; font-weight: 400; color: var(--mu); font-size: 12px; margin-left: 8px; white-space: nowrap; }
  .role { margin-top: 12px; padding-left: 12px; border-left: 2px solid var(--ln); }
  h4 { font-size: 14.5px; }
  .job ul { padding-left: 18px; margin-top: 5px !important; font-size: 13px; }
  .job li + li { margin-top: 2px; }
  blockquote { margin: 0; align-self: start; background: var(--sf); border-radius: 8px; padding: 10px 12px; font-style: italic; font-size: 11.5px; line-height: 1.4; color: var(--mu); }
  blockquote footer { margin-top: 6px; font-style: normal; font-size: 11px; }
  blockquote footer b { display: block; color: var(--gr); }

  .edu { display: grid; grid-template-columns: 1fr 1fr; gap: 8mm; padding-top: 14px; border-top: 1px solid var(--ln2); font-size: 13px; }
  .edu ul { padding-left: 18px; margin-top: 6px !important; }
  .edu ul.plain { list-style: none; padding-left: 0; }
  .edu li + li { margin-top: 3px; }

  @media (max-width: 720px) {
    .page { padding: 20px 16px; }
    .cols, .job, .edu { grid-template-columns: 1fr; }
    .head { flex-direction: column; align-items: flex-start; }
  }

  @page { size: A4; margin: 6mm 0; }
  @media print {
    html, body { background: #fff; }
    body { font-size: 12.5px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .sheet { margin: 0; max-width: none; gap: 0; display: block; }
    .page { box-shadow: none; background: #fff; width: 100%; max-width: none; height: auto; overflow: visible; padding: 9mm 13mm 0; break-after: page; break-inside: avoid; }
    .page:last-child { break-after: auto; }
    .edu, .edu > div { break-inside: avoid; }
    .cols { grid-template-columns: 1fr 62mm; }
    .job { grid-template-columns: 1fr 56mm !important; }
    .job:not(:has(blockquote)) { grid-template-columns: 1fr !important; }
    .edu { grid-template-columns: 1fr 1fr !important; }
    .head { flex-direction: row !important; align-items: center !important; }
    .page:nth-child(2) { font-size: 11px; }
    .page:nth-child(2) h2.big { font-size: 24px; margin-bottom: 8px; }
    .page:nth-child(2) .job { padding: 6px 0; gap: 6mm; }
    .page:nth-child(1) .timeline li { padding-bottom: 22px; }
    .page:nth-child(1) .head { padding-bottom: 18px; }
    .page:nth-child(1) .summary { margin: 20px 0 22px !important; font-size: 13.5px; }
    .page:nth-child(1) .cols { padding-top: 26px; }
    .page:nth-child(1) aside h2:not(:first-child) { margin-top: 28px; }
    .page:nth-child(1) .mini li { margin-bottom: 12px; }
    .page:nth-child(2) .job ul, .page:nth-child(2) .edu { font-size: 11px; }
    .page:nth-child(2) .role { margin-top: 6px; }
    .page:nth-child(2) blockquote { font-size: 10px; padding: 8px 10px; }
    .page:nth-child(2) h3 { font-size: 15px; }
    .page:nth-child(2) h4 { font-size: 13px; }
    .page:nth-child(2) .edu { padding-top: 8px; }
  }
</style>
