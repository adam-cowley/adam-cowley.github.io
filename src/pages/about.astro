---
import Base from "@layouts/Base.astro";
import Eyebrow from "@ui/atoms/Eyebrow.astro";
import Heading from "@ui/atoms/Heading.astro";
import Meta from "@ui/atoms/Meta.astro";
import Button from "@ui/atoms/Button.astro";
import SocialLinks from "@ui/molecules/SocialLinks.astro";
import PillarCard from "@ui/molecules/PillarCard.astro";
import home from "@config/home.json";
import { getEntry } from "astro:content";

const entry = await getEntry("about", "index");
if (!entry) throw new Error("About page not found");

const [first, last] = home.name;
const { Content } = await entry.render();
const { title, subtitle, description, meta_title, image } = entry.data;
---

<Base title={title} meta_title={meta_title ?? "About"} description={description ?? subtitle} image={image}>
  <div class="container">
    <section class="hero">
      <div class="talk" role="img" aria-label="Adam speaking at Neo4j GraphSummit">
        <!-- same cutout stacked 2x: lower body clipped to the circle, everything above the hips (head, arms) left free -->
        <img class="body" src="/images/adam-hands-cutout.png" alt="" width="779" height="1100" loading="eager" />
        <img class="head" src="/images/adam-hands-cutout.png" alt="" width="779" height="1100" loading="eager" />
      </div>
      <Eyebrow>/about</Eyebrow>
      <!-- Heading as="h1" size="display" class="name">{first}<br /><em>{last}</em></Heading -->
      <Heading as="h1" size="display" class="name">{title}</Heading>
      <div class="blurb">
        <Heading as="p" size="section" class="tagline">{home.tagline}</Heading>
        <!-- Meta><p class="role">{home.role}</p></Meta -->
      </div>
    </section>

    <div class="top">
      <div class="copy">
        <!--
        <Heading as="h2" size="title" class="h">{title}</Heading>
        {subtitle && <p class="sub">{subtitle}</p>}
        -->
        <div class="prose about-prose"><Content /></div>
      </div>
      <!-- aside class="side">
        <div class="portrait"><img src="/images/adam-cutout.png" alt="Adam Cowley" width="946" height="862" /></div>
        <SocialLinks inline={false} />
        <div class="cta">
          <Button href="/contact">Get in touch</Button>
        </div>
      </aside -->
    </div>

    <section class="pillars">
      {home.pillars.map((p, i) => <PillarCard index={i + 1} {...p} />)}
    </section>
  </div>
</Base>

<style>
.about-prose {
  margin: auto;
}
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 40px 72px;
    padding: clamp(24px, 4vw, 48px) 0 48px;
    align-items: flex-start;
  }
  .copy {
    flex: 3 1 420px;
    min-width: 0;
  }
  .copy :global(.h) {
    margin: 10px 0 20px;
  }
  .sub {
    font: 400 clamp(20px, 2.4vw, 26px) / 1.35 var(--serif);
    color: var(--ac);
    margin-bottom: 32px;
  }
  .hero {
    position: relative;
    padding-top: clamp(24px, 4vw, 40px);
    min-height: clamp(420px, 48vw, 560px);
    padding-bottom: clamp(24px, 4vw, 48px);
    border-bottom: 2px solid var(--ac);
  }
  .hero :global(.name) {
    position: relative;
    z-index: 2;
    padding-top: 10px;
    mix-blend-mode: normal;
    /* keep the name clear of the photo: wrap onto a second line instead of running underneath it */
    max-width: calc(100% - clamp(200px, 28vw, 360px) - 24px);
  }
  .blurb {
    position: relative;
    z-index: 2;
    margin-top: clamp(28px, 5vw, 56px);
    max-width: min(520px, calc(100% - clamp(200px, 28vw, 360px) - 24px));
  }
  .blurb :global(.tagline) {
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.12;
  }
  .role {
    margin: 14px 0 0;
    font-weight: 500;
    font-size: 13px;
    text-transform: uppercase;
  }
  .talk {
    position: absolute;
    right: 0;
    top: clamp(10px, 2vw, 30px);
    width: clamp(200px, 28vw, 360px);
    aspect-ratio: 779 / 1100;
    z-index: 0;
  }
  .talk::before {
    content: "";
    position: absolute;
    left: 3%;
    bottom: 0;
    width: 94%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff;
  }
  .talk img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .talk .body {
    clip-path: ellipse(47% 33.2% at 50% 66.8%);
  }
  .talk .head {
    clip-path: inset(0 0 21% 0);
  }
  .talk .neck {
    clip-path: inset(0 32% 62% 32%);
  }
  .side {
    flex: 1 1 260px;
    max-width: 340px;
    position: sticky;
    top: 24px;
  }
  .portrait {
    position: relative;
    aspect-ratio: 1;
    margin-bottom: 20px;
  }
  .portrait::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(160deg, #3aa9b5, #1f7f86);
  }
  .portrait img {
    position: absolute;
    left: 6%;
    bottom: 0;
    width: 88%;
    height: auto;
    display: block;
    /* head pops out of the circle; body is clipped to its lower half */
    clip-path: inset(-60% -10% 0 -10% round 0 0 999px 999px);
  }
  .cta {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    border-top: 2px solid var(--tx);
    margin-bottom: 56px;
  }
  @media (max-width: 760px) {
    .side {
      position: static;
      max-width: none;
    }
  }
</style>
