---
import Base from "@layouts/Base.astro";
import Hero from "@ui/organisms/Hero.astro";
import PillarGrid from "@ui/organisms/PillarGrid.astro";
import HomeColumns from "@ui/organisms/HomeColumns.astro";
import FeaturedPosts from "@ui/organisms/FeaturedPosts.astro";
import { getPosts } from "@lib/posts";

// "thoughts" are standalone posts, kept off the homepage
const posts = (await getPosts()).filter((p) => !p.categories.includes("thoughts"));
const latest = posts.slice(0, 5);
const talks = posts.filter((p) => p.tags.includes("talks")).slice(0, 3);
const tips = posts.filter((p) => p.categories.includes("til")).slice(0, 4);
const featured = posts.filter((p) => p.pinned).slice(0, 3);
---

<Base>
  <div class="container">
    <Hero />
  </div>
  <PillarGrid />
  <div class="container">
    <HomeColumns latest={latest} talks={talks} tips={tips} />
    <FeaturedPosts posts={featured} />
  </div>
</Base>
