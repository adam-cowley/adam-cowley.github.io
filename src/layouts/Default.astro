---
import PageTitle from "@ui/molecules/PageTitle.astro";

/** Plain markdown page (contact, etc). */
const { data } = Astro.props;
const { title } = data.data;
const { Content } = await data.render();
---

<div class="container">
  <PageTitle kicker={`/${data.slug}`} title={title} size="title" />
  <div class="prose body"><Content /></div>
</div>

<style>
  .body {
    border-top: 2px solid var(--tx);
    padding: 32px 0 48px;
  }
</style>
