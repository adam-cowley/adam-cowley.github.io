---
import config from "@config/config.json";
import { plainify } from "@lib/utils/textConverter";
import SiteHeader from "@ui/organisms/SiteHeader.astro";
import SiteFooter from "@ui/organisms/SiteFooter.astro";
import CommandPalette from "@ui/organisms/CommandPalette.astro";
import "@styles/global.css";
import "@styles/prose.css";

/** Document template: head, theme bootstrap, header, main slot, footer. */
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  type?: "website" | "article";
}

const { title, meta_title, description, image, noindex, canonical, type = "website" } = Astro.props;

const pageTitle = plainify(meta_title ?? title ?? config.site.title) ?? config.site.title;
const fullTitle = pageTitle === config.site.title ? pageTitle : `${pageTitle} | Adam Cowley`;
const desc = plainify(description ?? config.metadata.meta_description) ?? "";
const img = `${config.site.base_url}${image ?? config.metadata.meta_image}`;
const url = `${config.site.base_url}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={config.site.favicon} />
    <link rel="alternate" type="application/rss+xml" title="Adam Cowley" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={config.metadata.meta_author} />
    <meta name="theme-color" content="#1b2b23" />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical ?? url} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={img} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={img} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gloock&family=Geist:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- set the theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem("ac-theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") {
          t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <SiteHeader />
    <main id="main-content" class="page-enter">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette />
  </body>
</html>
