---
import Tag from "@ui/atoms/Tag.astro";
import PostHeader from "@ui/organisms/PostHeader.astro";
import PostToc from "@ui/organisms/PostToc.astro";
import RelatedPosts from "@ui/organisms/RelatedPosts.astro";
import config from "@config/config.json";
import { getPostEntries, toView } from "@lib/posts";
import similarItems from "@lib/utils/similarItems";
import { slugify, humanize } from "@lib/utils/textConverter";
import { getEntry } from "astro:content";

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { action, tags, image, title } = post.data;
const view = toView(post);

const author = await getEntry("authors", "adam");
const all = await getPostEntries();
const related = similarItems(post, all, post.slug).slice(0, 3).map(toView);
const url = `${config.site.base_url}/posts/${post.slug}`;
---

<article class="container">
  <PostHeader post={view} author={author?.data.title} />

  <div class="layout">
    <PostToc headings={headings} url={url} title={title} />

    <div class="main">
      {image && <img src={image} alt="" class="hero" width="1000" height="500" />}

      <div class="prose">
        <Content />
      </div>

      {
        action && (
          <aside class="action">
            <p set:html={action} />
          </aside>
        )
      }

      <ul class="tags">
        {tags.map((t: string) => <li><Tag href={`/tags/${slugify(t)}`}>#{humanize(t)}</Tag></li>)}
      </ul>

      <RelatedPosts posts={related} />
    </div>
  </div>
</article>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
    gap: 40px 64px;
    border-top: 1px solid var(--ln);
    padding: 36px 0 64px;
  }
  .main {
    min-width: 0;
    max-width: 700px;
  }
  .hero {
    width: 100%;
    height: auto;
    border: 1px solid var(--ln);
    margin-bottom: 36px;
    display: block;
  }
  .action {
    margin-top: 40px;
    padding: 28px;
    background: var(--sf);
    border-top: 3px solid var(--ac);
    text-align: center;
    font-weight: 600;
  }
  .action :global(a) {
    color: var(--ac);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
