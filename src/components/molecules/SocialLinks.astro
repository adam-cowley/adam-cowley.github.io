---
import { socialLinks } from "@lib/social";

interface Props {
  inline?: boolean;
}
const { inline = true } = Astro.props;
---

<ul class:list={["social", { inline }]}>
  {
    socialLinks.map((l) => (
      <li>
        <a href={l.href} class="u" target="_blank" rel="noopener me">{l.name} ↗</a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    list-style: none;
    margin: 0;
    padding: 0;
    font: 500 13px var(--mono);
    line-height: 2;
    color: var(--ac);
  }
  .inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }
</style>
