---
import Eyebrow from "@ui/atoms/Eyebrow.astro";
import Heading from "@ui/atoms/Heading.astro";

interface Props {
  index: number;
  title: string;
  description: string;
  href: string;
}
const { index, title, description, href } = Astro.props;
---

<a {href} class="pillar">
  <Eyebrow>What I do · {String(index).padStart(2, "0")}</Eyebrow>
  <Heading as="h2" size="section" class="t">{title}</Heading>
  <p>{description}</p>
  <span class="go">{href} →</span>
</a>

<style>
  .pillar {
    display: block;
    padding: 28px 28px 32px;
    border-left: 1px solid var(--ln);
    transition: background 0.25s;
  }
  .pillar:hover {
    background: var(--sf);
  }
  .pillar :global(.t) {
    font-size: clamp(30px, 3.2vw, 38px);
    line-height: 1.05;
    margin: 12px 0 10px;
  }
  p {
    color: var(--mu);
    font-size: 15px;
    line-height: 1.55;
  }
  .go {
    display: block;
    margin-top: 14px;
    font: 500 13px var(--mono);
    color: var(--ac);
  }
  @media (max-width: 820px) {
    .pillar {
      border-left: 0;
      border-top: 1px solid var(--ln);
      padding: 20px 0;
    }
    .pillar:hover {
      background: none;
    }
  }
</style>
