---
import SectionHeading from "@ui/molecules/SectionHeading.astro";
import PostRow from "@ui/molecules/PostRow.astro";
import TextLink from "@ui/atoms/TextLink.astro";
import type { PostView } from "@lib/posts";

interface Props {
  latest: PostView[];
  talks: PostView[];
  tips: PostView[];
}
const { latest, talks, tips } = Astro.props;
---

<section class="columns">
  <div class="col">
    <SectionHeading>Latest writing</SectionHeading>
    {latest.map((p) => <PostRow post={p} />)}
    <p class="more"><TextLink href="/posts" accent mono>All posts →</TextLink></p>
  </div>

  <div class="col mid">
    <SectionHeading>Today I learned</SectionHeading>
    {tips.map((p) => <PostRow post={p} />)}
    <p class="more"><TextLink href="/categories/til" accent mono>More notes →</TextLink></p>
  </div>

  <div class="col last">
    <SectionHeading>Talks</SectionHeading>
    {talks.map((p) => <PostRow post={p} />)}
    <p class="more"><TextLink href="/tags/talks" accent mono>All talks →</TextLink></p>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 44px 0;
  }
  .col {
    padding-right: 32px;
  }
  .mid {
    padding: 0 32px;
    border-left: 1px solid var(--ln);
    border-right: 1px solid var(--ln);
  }
  .last {
    padding: 0 0 0 32px;
  }
  .more {
    margin-top: 16px;
  }
  @media (max-width: 900px) {
    .columns {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 32px 0;
    }
    .col,
    .mid,
    .last {
      padding: 0;
      border: 0;
    }
  }
</style>
