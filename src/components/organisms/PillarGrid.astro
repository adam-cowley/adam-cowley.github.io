---
import PillarCard from "@ui/molecules/PillarCard.astro";
import home from "@config/home.json";
---

<section class="strip" aria-label="What I do">
  <div class="container pillars">
    {home.pillars.map((p, i) => <PillarCard index={i + 1} {...p} />)}
  </div>
</section>

<style>
  .strip {
    margin-top: 56px;
    border-top: 1px solid var(--ln);
    border-bottom: 1px solid var(--ln);
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .pillars > :global(:first-child) {
    border-left: 0;
  }
  @media (max-width: 820px) {
    .pillars > :global(:first-child) {
      border-top: 0;
    }
  }
</style>
