---
import Eyebrow from "@ui/atoms/Eyebrow.astro";

interface Props {
  headings: { depth: number; slug: string; text: string }[];
  url: string;
  title: string;
}
const { headings, url, title } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
const share = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
---

<aside class="toc">
  {
    items.length > 1 && (
      <>
        <Eyebrow class="label">On this page</Eyebrow>
        <nav aria-label="Table of contents">
          {items.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
      </>
    )
  }
  <div class="share">
    <a class="u" href={share} target="_blank" rel="noopener">Share ↗</a> ·
    <button type="button" class="u" data-copy={url}>Copy link</button>
  </div>
</aside>

<style>
  .toc {
    position: sticky;
    top: 20px;
    align-self: start;
  }
  .toc :global(.label) {
    margin-bottom: 12px;
  }
  nav a {
    display: block;
    padding: 6px 0 6px 14px;
    border-left: 1px solid var(--ln);
    font-size: 14px;
    color: var(--mu);
    transition: color 0.2s, border-color 0.2s;
  }
  nav a:hover {
    color: var(--ac);
    border-left-color: var(--ac);
  }
  .share {
    margin-top: 22px;
    font: 500 12px var(--mono);
    color: var(--ac);
    line-height: 2;
  }
  .share button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
  }
  @media (max-width: 960px) {
    .toc {
      position: static;
    }
    nav {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element).closest<HTMLElement>("[data-copy]");
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      const before = btn.textContent;
      btn.textContent = "Copied ✓";
      setTimeout(() => (btn.textContent = before), 1500);
    } catch {}
  });
</script>
