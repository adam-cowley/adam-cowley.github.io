---
import Eyebrow from "@ui/atoms/Eyebrow.astro";
import FeatureCard from "@ui/molecules/FeatureCard.astro";
import type { PostView } from "@lib/posts";

interface Props {
  posts: PostView[];
}
const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="featured">
      <Eyebrow as="h2" class="label">Start here</Eyebrow>
      <div class="grid">
        {posts.map((p) => <FeatureCard post={p} />)}
      </div>
    </section>
  )
}

<style>
  .featured {
    border-top: 1px solid var(--ln);
    padding: 36px 0;
  }
  .featured :global(.label) {
    margin-bottom: 20px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
</style>
