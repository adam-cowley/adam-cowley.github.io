---
import Heading from "@ui/atoms/Heading.astro";
import Meta from "@ui/atoms/Meta.astro";
import CircleArt from "@ui/visuals/CircleArt.astro";
import home from "@config/home.json";

const [first, last] = home.name;
---

<section class="hero">
  <div class="art" aria-hidden="true"><CircleArt variant="overlap" animate={false} /></div>
  <Heading as="h1" size="display" class="name">{first}<br /><em>{last}</em></Heading>
  <div class="blurb">
    <Heading as="p" size="section" class="tagline">{home.tagline}</Heading>
    <Meta><p class="role">{home.role}</p></Meta>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(24px, 4vw, 40px);
    min-height: clamp(480px, 56vw, 640px);
  }
  .art {
    position: absolute;
    right: clamp(-60px, -3vw, 0px);
    top: clamp(30px, 5vw, 50px);
    width: clamp(260px, 42vw, 520px);
    z-index: 0;
  }
  .hero :global(.name) {
    position: relative;
    z-index: 2;
    padding-top: clamp(20px, 5vw, 60px);
  }
  .blurb {
    position: relative;
    z-index: 2;
    margin-top: clamp(28px, 5vw, 64px);
    max-width: 560px;
  }
  .blurb :global(.tagline) {
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.12;
  }
  .role {
    margin: 14px 0 0;
    font-weight: 500;
    font-size: 13px;
    text-transform: uppercase;
  }
</style>
