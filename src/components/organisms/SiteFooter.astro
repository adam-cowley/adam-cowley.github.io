---
import Heading from "@ui/atoms/Heading.astro";
import Button from "@ui/atoms/Button.astro";
import SocialLinks from "@ui/molecules/SocialLinks.astro";
import EasterEgg from "@ui/organisms/EasterEgg.astro";
import config from "@config/config.json";

const year = new Date().getFullYear();
const copyright = config.params.copyright.replace("{year}", String(year));
---

<footer class="container">
  <div class="inner">
    <div class="about">
      <div class="portrait"><img src="/images/adam-cutout.png" alt="Adam Cowley" width="946" height="862" /></div>
      <p class="blurb">
        I design and build systems, and increasingly use AI to make them faster to build and better over time.
      </p>
    </div>
    <nav class="col" aria-label="Site">
      <span class="label">Site</span>
      <a class="u" href="/about">/about</a>
      <a class="u" href="/contact">/contact</a>
      <a class="u" href="/tags">/tags</a>
      <a class="u" href="/rss.xml">RSS</a>
    </nav>
    <div class="col">
      <span class="label">Elsewhere</span>
      <SocialLinks inline={false} />
    </div>
  </div>
  <div class="base">
    <p class="copy">{copyright}</p>
    <div class="hint" aria-hidden="true">↑ ↑ ↓ ↓ ← → ← → B A</div>
  </div>
</footer>
<EasterEgg />

<style>
  footer {
    margin-top: 40px;
  }
  .inner {
    padding: 40px 0 32px;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(2, minmax(0, 1fr));
    gap: 32px 56px;
    align-items: start;
    border-top: 1px solid var(--ln);
  }
  .about {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .portrait {
    position: relative;
    flex: none;
    aspect-ratio: 1;
    width: 112px;
  }
  .portrait::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(160deg, #3aa9b5, #1f7f86);
  }
  .portrait img {
    position: absolute;
    left: 6%;
    bottom: 0;
    width: 88%;
    height: auto;
    display: block;
    /* head pops out of the circle; body is clipped to its lower half */
    clip-path: inset(-60% -10% 0 -10% round 0 0 999px 999px);
  }
  .blurb {
    font-size: 16px;
    line-height: 1.6;
    color: var(--mu);
    max-width: 38ch;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font: 500 14px var(--mono);
    line-height: 1.8;
    color: var(--ac);
  }
  .label {
    font: 500 11px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mu);
    margin-bottom: 4px;
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 20px 0 32px;
    border-top: 1px solid var(--ln2);
    font: 400 13px var(--mono);
    color: var(--mu);
  }
  .copy {
    margin: 0;
  }
  .hint {
    opacity: 0.7;
  }
  @media (max-width: 820px) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  @media print {
    footer {
      display: none;
    }
  }
</style>
