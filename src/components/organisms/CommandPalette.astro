---
import { getPosts, groupBy } from "@lib/posts";
import home from "@config/home.json";

const posts = await getPosts();
const items = [
  { label: "Home", kind: "page", href: "/" },
  ...home.nav.map((n) => ({ label: n.name.replace("/", "").replace(/^./, (c) => c.toUpperCase()), kind: "page", href: n.url })),
  { label: "Contact", kind: "page", href: "/contact" },
  ...groupBy(posts, "categories").map((c) => ({ label: c.label, kind: "topic", href: `/categories/${c.slug}` })),
  ...posts.map((p) => ({ label: p.title, kind: "post", href: p.href })),
];
---

<dialog id="palette" class="palette" aria-label="Command palette" data-items={JSON.stringify(items)}>
  <div class="box">
    <label class="field">
      <span class="key">⌘K</span>
      <input type="text" placeholder="Search posts, topics, pages" autocomplete="off" aria-label="Search" />
    </label>
    <ul class="results" role="listbox"></ul>
  </div>
</dialog>

<style>
  .palette {
    padding: 0;
    border: 0;
    background: transparent;
    width: 100%;
    max-width: 560px;
    margin: 12vh auto 0;
    color: var(--tx);
  }
  .palette::backdrop {
    background: rgba(10, 18, 14, 0.6);
  }
  .box {
    background: var(--bg);
    border: 1px solid var(--ac);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
    margin: 0 16px;
  }
  .field {
    display: flex;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--ln);
    font: 400 14px var(--mono);
  }
  .key {
    color: var(--ac);
  }
  input {
    flex: 1;
    background: none;
    border: 0;
    outline: 0;
    color: var(--tx);
    font: inherit;
  }
  input::placeholder {
    color: var(--mu);
    opacity: 1;
  }
  .results {
    list-style: none;
    margin: 0;
    padding: 6px 0;
    max-height: 50vh;
    overflow: auto;
  }
  .results :global(a) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    font-size: 16px;
  }
  .results :global(a[aria-selected="true"]),
  .results :global(a:hover) {
    background: var(--sf);
  }
  .results :global(small) {
    font: 400 16px var(--mono);
    color: var(--ac);
    text-transform: uppercase;
    white-space: nowrap;
    padding-top: 3px;
  }
  .results :global(li.empty) {
    padding: 12px 16px;
    font: 400 14px var(--mono);
    color: var(--mu);
  }
</style>

<script>
  interface Item {
    label: string;
    kind: string;
    href: string;
  }
  const dialog = document.querySelector<HTMLDialogElement>("#palette")!;
  const input = dialog.querySelector("input")!;
  const list = dialog.querySelector<HTMLUListElement>(".results")!;
  const items: Item[] = JSON.parse(dialog.dataset.items ?? "[]");
  let shown: Item[] = [];
  let active = 0;

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  const render = () => {
    const q = input.value.trim().toLowerCase();
    shown = items.filter((i) => !q || i.label.toLowerCase().includes(q)).slice(0, 8);
    active = Math.min(active, Math.max(0, shown.length - 1));
    list.innerHTML = shown.length
      ? shown
          .map((i, n) => `<li><a href="${esc(i.href)}" role="option" aria-selected="${n === active}"><span>${esc(i.label)}</span><small>${i.kind}</small></a></li>`)
          .join("")
      : `<li class="empty">Nothing found.</li>`;
  };

  const open = () => {
    if (dialog.open) return;
    input.value = "";
    active = 0;
    render();
    dialog.showModal();
    input.focus();
  };

  document.addEventListener("click", (e) => {
    const t = e.target as Element;
    if (t.closest("[data-palette-open]")) open();
    else if (t === dialog) dialog.close(); // backdrop click
  });
  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    }
  });
  input.addEventListener("input", () => {
    active = 0;
    render();
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      active = (active + (e.key === "ArrowDown" ? 1 : -1) + shown.length) % Math.max(1, shown.length);
      render();
    } else if (e.key === "Enter" && shown[active]) {
      location.href = shown[active].href;
    }
  });
</script>
